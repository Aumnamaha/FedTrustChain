# Python bytecode and cache
__pycache__/
*.pyc

# Virtual environment
.venv/

# Environment variables
.env

# IDE settings
.vscode/
.idea/

# Logs
*.log

# Data files (keep raw datasets out of git)
# Allow only .gitkeep placeholder; everything else in Datasets/ is ignored
!data/Datasets/.gitkeep
data/Datasets/*
data/*.csv
data/*.parquet

# Results/output directory
results/
